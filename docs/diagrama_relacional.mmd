
erDiagram

    EQUIPAMENTO ||--o{ MANUTENCAO : possui
    TECNICO ||--o{ MANUTENCAO : realiza

    EQUIPAMENTO {
        NUMBER ID_EQUIPAMENTO PK "Chave primaria"
        VARCHAR2_100 NOME "NOT NULL"
        VARCHAR2_100 MODELO "NOT NULL"
        VARCHAR2_50 NUMERO_SERIE UK "NOT NULL e UNIQUE"
        VARCHAR2_20 STATUS "NOT NULL"
    }

    TECNICO {
        NUMBER ID_TECNICO PK "Chave primaria"
        VARCHAR2_100 NOME "NOT NULL"
        VARCHAR2_100 ESPECIALIDADE "NOT NULL"
    }

    MANUTENCAO {
        NUMBER ID_MANUTENCAO PK "Chave primaria"
        NUMBER ID_EQUIPAMENTO FK "NOT NULL"
        NUMBER ID_TECNICO FK "NOT NULL"
        DATE DATA_MANUTENCAO "NOT NULL"
        VARCHAR2_500 DESCRICAO "NOT NULL"
        NUMBER_10_2 CUSTO "NOT NULL e CHECK >= 0"
    }
